# =================================================================
# AI Remote Desktop Assistant — Environment Configuration
# =================================================================

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
ALLOWED_ORIGINS=*

# AnyDesk-Style Device Identifier & Password
# Set to 'auto' or leave blank to automatically assign a unique persistent 9-digit ID per physical machine
DESK_ID=auto
UNATTENDED_ACCESS_PASSWORD=
ALLOW_DIRECT_CONTROL=true
ALLOW_FILE_TRANSFER=true
ALLOW_CLIPBOARD_SYNC=true

# Generative AI Multimodal Provider Selection
DEFAULT_VLM_PROVIDER=gemini # Options: gemini | claude | openai | local
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_VLM_BASE_URL=http://localhost:11434/v1

# Selected AI Models
GEMINI_MODEL=gemini-2.5-pro
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o

# Voice Subsystem
ENABLE_VOICE=true
STT_ENGINE=faster_whisper # faster_whisper | deepgram
TTS_ENGINE=edge_tts       # edge_tts | kokoro | elevenlabs
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Safety & Human-In-The-Loop (HITL)
SAFETY_MODE=interactive   # full_auto | interactive | read_only
ENABLE_PRIVACY_BLUR=true
EMERGENCY_KILLSWITCH_KEY=ctrl+shift+alt+k
MAX_RETRY_PER_STEP=3
LOG_LEVEL=INFO
